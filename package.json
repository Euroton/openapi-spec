{
  "name": "@euroton/openapi-spec",
  "version": "0.0.1",
  "description": "OpenAPI 3.1 specification of the Proton server API, mechanically extracted from upstream ProtonWebClients TypeScript sources.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "tsx src/cli.ts extract",
    "lint": "spectral lint spec/euroton.openapi.yaml",
    "build": "tsc --noEmit"
  },
  "bin": {
    "euroton-openapi": "src/cli.ts"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "commander": "^12.1.0",
    "ts-morph": "^24.0.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.14.2",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
